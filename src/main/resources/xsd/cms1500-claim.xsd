<?xml version="1.0" encoding="UTF-8"?>
<!--
  CMS-1500 (02/12) claim contract.
  This schema is the single source of truth for both bindings the service exposes:
    - SOAP: the root elements below form the WSDL messages (see /ws/cms1500.wsdl)
    - REST: the Cms1500Claim type is the JSON body of POST /api/v1/claims/cms1500,
            ClaimBundleResult is the success body and ClaimFault the error body.
  Item numbers in comments refer to the numbered boxes on the paper form.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://interop.thehiddenbrain.com/cms1500/v1"
           targetNamespace="http://interop.thehiddenbrain.com/cms1500/v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <!-- ======================= SOAP root elements ======================= -->

  <xs:element name="generateClaimBundleRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="claim" type="tns:Cms1500Claim"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="generateClaimBundleResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="result" type="tns:ClaimBundleResult"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="generateClaimBundleFault" type="tns:ClaimFault"/>

  <!-- ======================= Claim ======================= -->

  <xs:complexType name="Cms1500Claim">
    <xs:annotation><xs:documentation>One CMS-1500 claim. Optional elements left out are left blank on the form.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="claimNumber" type="tns:ClaimNumber">
        <xs:annotation><xs:documentation>Caller's claim identifier. Names the bundle (&lt;claimNumber&gt;.pdf) and selects attachments (&lt;claimNumber&gt;_1.pdf, ...). Not printed on the form.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="carrier" type="tns:Carrier" minOccurs="0">
        <xs:annotation><xs:documentation>Payer name and address printed in the top-right carrier block.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="insuranceType" type="tns:InsuranceType">
        <xs:annotation><xs:documentation>Item 1.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="insuredId" type="tns:Text29" minOccurs="0">
        <xs:annotation><xs:documentation>Item 1a. Insured's ID number.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="patient" type="tns:Patient">
        <xs:annotation><xs:documentation>Items 2, 3, 5, 6, 12.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="insured" type="tns:Insured" minOccurs="0">
        <xs:annotation><xs:documentation>Items 4, 7, 11, 11a-11d, 13. Required unless patient.relationshipToInsured is SELF, in which case items 4 and 7 are copied from the patient when omitted.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="otherInsured" type="tns:OtherInsured" minOccurs="0">
        <xs:annotation><xs:documentation>Items 9, 9a, 9d. Required when insured.anotherHealthBenefitPlan is true.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="condition" type="tns:Condition" minOccurs="0">
        <xs:annotation><xs:documentation>Item 10a-10d.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="dateOfCurrentIllness" type="xs:date" minOccurs="0">
        <xs:annotation><xs:documentation>Item 14. Date of current illness, injury or pregnancy (LMP).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="dateOfCurrentIllnessQualifier" type="tns:Item14Qualifier" minOccurs="0">
        <xs:annotation><xs:documentation>Item 14 QUAL: 431 onset of current symptoms/illness, 484 last menstrual period.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="otherDate" type="xs:date" minOccurs="0">
        <xs:annotation><xs:documentation>Item 15.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="otherDateQualifier" type="tns:Item15Qualifier" minOccurs="0">
        <xs:annotation><xs:documentation>Item 15 QUAL: 454 initial treatment, 304 latest visit, 453 acute manifestation, 439 accident, 455 last x-ray, 471 prescription, 090 report start, 091 report end, 444 first visit, 050 assumed care, 054 relinquished care.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="unableToWorkFrom" type="xs:date" minOccurs="0">
        <xs:annotation><xs:documentation>Item 16 FROM.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="unableToWorkTo" type="xs:date" minOccurs="0">
        <xs:annotation><xs:documentation>Item 16 TO.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="referringProvider" type="tns:ReferringProvider" minOccurs="0">
        <xs:annotation><xs:documentation>Items 17, 17a, 17b.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="hospitalizationFrom" type="xs:date" minOccurs="0">
        <xs:annotation><xs:documentation>Item 18 FROM.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="hospitalizationTo" type="xs:date" minOccurs="0">
        <xs:annotation><xs:documentation>Item 18 TO.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="additionalClaimInfo" type="tns:Text71" minOccurs="0">
        <xs:annotation><xs:documentation>Item 19.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="outsideLab" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 20.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="outsideLabCharges" type="tns:Money" minOccurs="0">
        <xs:annotation><xs:documentation>Item 20 $ CHARGES. Only valid when outsideLab is true.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="icdIndicator" type="tns:IcdIndicator" minOccurs="0">
        <xs:annotation><xs:documentation>Item 21 ICD Ind. Required when diagnoses are present. Defaults to ICD10.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="diagnoses" type="tns:DiagnosisCode" minOccurs="0" maxOccurs="12">
        <xs:annotation><xs:documentation>Item 21 A-L in order. Periods are removed on the form.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="resubmissionCode" type="tns:Text11" minOccurs="0">
        <xs:annotation><xs:documentation>Item 22 resubmission code (7 replacement, 8 void).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="originalReferenceNumber" type="tns:Text18" minOccurs="0">
        <xs:annotation><xs:documentation>Item 22 original ref. no.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="priorAuthorizationNumber" type="tns:Text29" minOccurs="0">
        <xs:annotation><xs:documentation>Item 23.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="serviceLines" type="tns:ServiceLine" maxOccurs="unbounded">
        <xs:annotation><xs:documentation>Item 24 lines. More than six lines continue on additional form pages.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="federalTaxId" type="tns:TaxId" minOccurs="0">
        <xs:annotation><xs:documentation>Item 25. Nine digits, no punctuation.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="federalTaxIdType" type="tns:TaxIdType" minOccurs="0">
        <xs:annotation><xs:documentation>Item 25 SSN / EIN.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="patientAccountNumber" type="tns:Text14" minOccurs="0">
        <xs:annotation><xs:documentation>Item 26.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="acceptAssignment" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 27.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="totalCharge" type="tns:Money" minOccurs="0">
        <xs:annotation><xs:documentation>Item 28. Computed from the service lines when omitted; rejected when present but different from that sum.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="amountPaid" type="tns:Money" minOccurs="0">
        <xs:annotation><xs:documentation>Item 29.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="physicianSignature" type="tns:Signature" minOccurs="0">
        <xs:annotation><xs:documentation>Item 31.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="serviceFacility" type="tns:ServiceFacility" minOccurs="0">
        <xs:annotation><xs:documentation>Items 32, 32a, 32b.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="billingProvider" type="tns:BillingProvider">
        <xs:annotation><xs:documentation>Items 33, 33a, 33b.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Carrier">
    <xs:sequence>
      <xs:element name="name" type="tns:Text40"/>
      <xs:element name="street" type="tns:Text40" minOccurs="0"/>
      <xs:element name="street2" type="tns:Text40" minOccurs="0"/>
      <xs:element name="city" type="tns:Text24" minOccurs="0"/>
      <xs:element name="state" type="tns:StateCode" minOccurs="0"/>
      <xs:element name="zip" type="tns:Zip" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PersonName">
    <xs:sequence>
      <xs:element name="lastName" type="tns:Text28"/>
      <xs:element name="firstName" type="tns:Text28"/>
      <xs:element name="middleInitial" type="tns:Text1" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Address">
    <xs:sequence>
      <xs:element name="street" type="tns:Text29"/>
      <xs:element name="city" type="tns:Text24"/>
      <xs:element name="state" type="tns:StateCode"/>
      <xs:element name="zip" type="tns:Zip"/>
      <xs:element name="phoneAreaCode" type="tns:AreaCode" minOccurs="0"/>
      <xs:element name="phoneNumber" type="tns:PhoneNumber" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Patient">
    <xs:sequence>
      <xs:element name="name" type="tns:PersonName"/>
      <xs:element name="dateOfBirth" type="xs:date"/>
      <xs:element name="sex" type="tns:Sex"/>
      <xs:element name="address" type="tns:Address"/>
      <xs:element name="relationshipToInsured" type="tns:Relationship"/>
      <xs:element name="signatureOnFile" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 12. true prints SIGNATURE ON FILE.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="signatureDate" type="xs:date" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Insured">
    <xs:sequence>
      <xs:element name="name" type="tns:PersonName" minOccurs="0"/>
      <xs:element name="address" type="tns:Address" minOccurs="0"/>
      <xs:element name="policyGroupNumber" type="tns:Text29" minOccurs="0">
        <xs:annotation><xs:documentation>Item 11. Use NONE when Medicare is primary.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="dateOfBirth" type="xs:date" minOccurs="0"/>
      <xs:element name="sex" type="tns:Sex" minOccurs="0"/>
      <xs:element name="otherClaimIdQualifier" type="tns:OtherClaimIdQualifier" minOccurs="0">
        <xs:annotation><xs:documentation>Item 11b qualifier (Y4 property casualty claim number).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="otherClaimId" type="tns:Text28" minOccurs="0"/>
      <xs:element name="planName" type="tns:Text29" minOccurs="0">
        <xs:annotation><xs:documentation>Item 11c.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="anotherHealthBenefitPlan" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 11d.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="signatureOnFile" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 13. true prints SIGNATURE ON FILE.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OtherInsured">
    <xs:sequence>
      <xs:element name="name" type="tns:PersonName"/>
      <xs:element name="policyGroupNumber" type="tns:Text28" minOccurs="0"/>
      <xs:element name="planName" type="tns:Text28" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Condition">
    <xs:sequence>
      <xs:element name="employmentRelated" type="xs:boolean" minOccurs="0"/>
      <xs:element name="autoAccident" type="xs:boolean" minOccurs="0"/>
      <xs:element name="autoAccidentState" type="tns:StateCode" minOccurs="0"/>
      <xs:element name="otherAccident" type="xs:boolean" minOccurs="0"/>
      <xs:element name="claimCodes" type="tns:Text19" minOccurs="0">
        <xs:annotation><xs:documentation>Item 10d claim codes (designated by NUCC).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReferringProvider">
    <xs:sequence>
      <xs:element name="qualifier" type="tns:ReferringQualifier">
        <xs:annotation><xs:documentation>DN referring, DK ordering, DQ supervising.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="name" type="tns:Text26"/>
      <xs:element name="otherIdQualifier" type="tns:OtherIdQualifier" minOccurs="0"/>
      <xs:element name="otherId" type="tns:Text17" minOccurs="0"/>
      <xs:element name="npi" type="tns:Npi" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ServiceLine">
    <xs:sequence>
      <xs:element name="dateFrom" type="xs:date"/>
      <xs:element name="dateTo" type="xs:date" minOccurs="0"/>
      <xs:element name="placeOfService" type="tns:PlaceOfService"/>
      <xs:element name="emergency" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 24C. true prints Y.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="procedureCode" type="tns:ProcedureCode"/>
      <xs:element name="modifiers" type="tns:Modifier" minOccurs="0" maxOccurs="4"/>
      <xs:element name="diagnosisPointers" type="tns:DiagnosisPointers">
        <xs:annotation><xs:documentation>Item 24E. Letters A-L referencing the diagnoses list, e.g. AB.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="charges" type="tns:Money"/>
      <xs:element name="units" type="tns:Units"/>
      <xs:element name="epsdt" type="tns:EpsdtCode" minOccurs="0">
        <xs:annotation><xs:documentation>Item 24H shaded: EPSDT reason code AV, S2, ST or NU.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="familyPlanning" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>Item 24H unshaded: true prints Y.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="renderingProviderIdQualifier" type="tns:RenderingIdQualifier" minOccurs="0">
        <xs:annotation><xs:documentation>Item 24I shaded.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="renderingProviderOtherId" type="tns:Text11" minOccurs="0">
        <xs:annotation><xs:documentation>Item 24J shaded.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="renderingProviderNpi" type="tns:Npi" minOccurs="0">
        <xs:annotation><xs:documentation>Item 24J unshaded.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="supplementalInfo" type="tns:Text61" minOccurs="0">
        <xs:annotation><xs:documentation>Shaded supplemental area above the line (e.g. N4 NDC qualifier + code).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Signature">
    <xs:sequence>
      <xs:element name="name" type="tns:Text26" minOccurs="0">
        <xs:annotation><xs:documentation>Provider name and credentials printed as the signature.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="onFile" type="xs:boolean" minOccurs="0">
        <xs:annotation><xs:documentation>true prints SIGNATURE ON FILE instead of the name.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="date" type="xs:date" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ServiceFacility">
    <xs:sequence>
      <xs:element name="name" type="tns:Text26"/>
      <xs:element name="street" type="tns:Text26" minOccurs="0"/>
      <xs:element name="city" type="tns:Text24" minOccurs="0"/>
      <xs:element name="state" type="tns:StateCode" minOccurs="0"/>
      <xs:element name="zip" type="tns:Zip" minOccurs="0"/>
      <xs:element name="npi" type="tns:Npi" minOccurs="0"/>
      <xs:element name="otherId" type="tns:Text14" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BillingProvider">
    <xs:sequence>
      <xs:element name="name" type="tns:Text29"/>
      <xs:element name="street" type="tns:Text29"/>
      <xs:element name="city" type="tns:Text24"/>
      <xs:element name="state" type="tns:StateCode"/>
      <xs:element name="zip" type="tns:Zip"/>
      <xs:element name="phoneAreaCode" type="tns:AreaCode" minOccurs="0"/>
      <xs:element name="phoneNumber" type="tns:PhoneNumber" minOccurs="0"/>
      <xs:element name="npi" type="tns:Npi"/>
      <xs:element name="otherId" type="tns:Text17" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================= Result / fault ======================= -->

  <xs:complexType name="ClaimBundleResult">
    <xs:sequence>
      <xs:element name="status" type="tns:ResultStatus"/>
      <xs:element name="claimNumber" type="tns:ClaimNumber"/>
      <xs:element name="fileName" type="xs:string"/>
      <xs:element name="bundlePath" type="xs:string">
        <xs:annotation><xs:documentation>Absolute path of the bundle on the shared drive.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="totalPages" type="xs:int"/>
      <xs:element name="formPages" type="xs:int"/>
      <xs:element name="attachmentCount" type="xs:int"/>
      <xs:element name="attachments" type="tns:BundledAttachment" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="warnings" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="replacedExisting" type="xs:boolean"/>
      <xs:element name="generatedAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BundledAttachment">
    <xs:sequence>
      <xs:element name="index" type="xs:int"/>
      <xs:element name="fileName" type="xs:string"/>
      <xs:element name="type" type="tns:AttachmentType"/>
      <xs:element name="pages" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ClaimFault">
    <xs:sequence>
      <xs:element name="status" type="tns:FaultStatus"/>
      <xs:element name="claimNumber" type="xs:string" minOccurs="0"/>
      <xs:element name="code" type="tns:ErrorCode"/>
      <xs:element name="message" type="xs:string"/>
      <xs:element name="details" type="tns:ViolationDetail" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ViolationDetail">
    <xs:sequence>
      <xs:element name="field" type="xs:string"/>
      <xs:element name="message" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================= Simple types ======================= -->

  <xs:simpleType name="ClaimNumber">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._\-]{0,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InsuranceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="MEDICARE"/>
      <xs:enumeration value="MEDICAID"/>
      <xs:enumeration value="TRICARE"/>
      <xs:enumeration value="CHAMPVA"/>
      <xs:enumeration value="GROUP_HEALTH_PLAN"/>
      <xs:enumeration value="FECA_BLACK_LUNG"/>
      <xs:enumeration value="OTHER"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Sex">
    <xs:restriction base="xs:string">
      <xs:enumeration value="M"/>
      <xs:enumeration value="F"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Relationship">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SELF"/>
      <xs:enumeration value="SPOUSE"/>
      <xs:enumeration value="CHILD"/>
      <xs:enumeration value="OTHER"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TaxIdType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SSN"/>
      <xs:enumeration value="EIN"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IcdIndicator">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ICD10"/>
      <xs:enumeration value="ICD9"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ResultStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="GENERATED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FaultStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ERROR"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AttachmentType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PDF"/>
      <xs:enumeration value="IMAGE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ErrorCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="MALFORMED_REQUEST"/>
      <xs:enumeration value="VALIDATION_ERROR"/>
      <xs:enumeration value="NO_ATTACHMENTS"/>
      <xs:enumeration value="UNSUPPORTED_ATTACHMENT"/>
      <xs:enumeration value="ATTACHMENT_UNREADABLE"/>
      <xs:enumeration value="BUNDLE_EXISTS"/>
      <xs:enumeration value="BUNDLE_NOT_FOUND"/>
      <xs:enumeration value="TEMPLATE_ERROR"/>
      <xs:enumeration value="STORAGE_ERROR"/>
      <xs:enumeration value="INTERNAL_ERROR"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Item14Qualifier">
    <xs:restriction base="xs:string"><xs:pattern value="431|484"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Item15Qualifier">
    <xs:restriction base="xs:string"><xs:pattern value="454|304|453|439|455|471|090|091|444|050|054"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReferringQualifier">
    <xs:restriction base="xs:string"><xs:pattern value="DN|DK|DQ"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OtherIdQualifier">
    <xs:restriction base="xs:string"><xs:pattern value="0B|1G|G2|LU"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RenderingIdQualifier">
    <xs:restriction base="xs:string"><xs:pattern value="0B|1G|G2|LU|ZZ"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OtherClaimIdQualifier">
    <xs:restriction base="xs:string"><xs:pattern value="Y4"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EpsdtCode">
    <xs:restriction base="xs:string"><xs:pattern value="AV|S2|ST|NU"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StateCode">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z]{2}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Zip">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{5}(-?[0-9]{4})?"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AreaCode">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{3}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PhoneNumber">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{7}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Npi">
