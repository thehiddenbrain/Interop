        <mxCell id="e5" value="5. response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1A2430;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A2430;labelBackgroundColor=#FFFFFF;verticalAlign=top;exitX=0.0;exitY=0.63;exitDx=0;exitDy=0;entryX=1.0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="apim" target="onyx">
