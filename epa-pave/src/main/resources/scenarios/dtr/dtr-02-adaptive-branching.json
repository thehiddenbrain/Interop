{
  "id": "dtr-02-adaptive-branching",
  "number": 2,
  "label": "Adaptive sequence, a later question depends on an earlier answer",
  "description": "The package holds one adaptive questionnaire with no questions of its own, and the response to start it from. Each next-question call returns the questions so far. Answering yes to the first question brings one follow-up, answering no brings a different one, and changing the first answer afterwards makes the earlier follow-up disappear. It models DTR 2.0.1.",
  "sentinelMemberId": "P32H-DTR-ADAPT",
  "behavior": "respond",
  "httpStatus": 200,
  "delayMillis": 150,
  "expect": {
    "outcome": "PACKAGE_LOADED",
    "errorType": "NONE",
    "httpStatus": 200,
    "codes": {
      "questionnaires": "1",
      "questionnaire-kind": "adaptive",
      "questionnaire-status": "active",
      "questions": "0"
    }
  },
  "basis": "Synthetic. Shaped to DTR 2.0.1, the version this tool is held to, from the guide's own examples where it has them, with this project's placeholders for every value the guide leaves open. It has not been observed from the live service.",
  "assumption": "What the live service does at each of these points is not confirmed. This file models what DTR 2.0.1 and SDC publish: the questionnaire in the package declares the adaptive search profile, holds no items and carries the questionnaireAdaptive extension as a url; the package carries a draft QuestionnaireResponse to start from, which names the coverage and the order in qr-context, states its intended use, and holds the questionnaire inside itself with no url of its own, derived from the one in the package; each next-question answer is that response with the questions so far in the contained questionnaire; the status is in-progress while questions remain and completed at the end. The draft holds no item, as SDC has the first next-question call carry none, although DTR 2.0.1 asks every QuestionnaireResponse for at least one: the two guides differ there. It also models a service that returns the answers it was sent and drops the answer to a question it no longer asks, which the guides do not define. Each step holds only what the service changes at that point, the questions and the status: the mock returns the response it was sent with those replaced, so the response that comes back carries the coverage, the order, the intended use, the subject and the time it was authored that were sent.",
  "nextQuestion": {
    "rule": "The step is chosen from the answers in the QuestionnaireResponse that was sent. Each entry lists linkIds with the answer each must have: a code or a value, (any) for any answer at all, or (none) for no answer. The first entry that fits, in the order written, names the step. Answers that fit no entry are refused.",
    "select": [
      {
        "when": {
          "mri-1-therapy": "(none)"
        },
        "step": "first-question"
      },
      {
        "when": {
          "mri-1-therapy": "yes",
          "mri-2-weeks": "(none)"
        },
        "step": "therapy-weeks"
      },
      {
        "when": {
          "mri-1-therapy": "yes",
          "mri-2-weeks": "(any)"
        },
        "step": "complete-after-therapy"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "(none)"
        },
        "step": "red-flag"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "true",
          "mri-3-red-flag-detail": "(none)"
        },
        "step": "red-flag-detail"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "true",
          "mri-3-red-flag-detail": "(any)"
        },
        "step": "complete-with-red-flag"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "false"
        },
        "step": "complete-without-red-flag"
      }
    ]
  },
