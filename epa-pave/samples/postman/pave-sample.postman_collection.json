      "name": "CRD",
      "item": [
        {
          "name": "order-sign Happy Path",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sample pre-request script. PAVE never runs a script: it flags this request instead.",
                  "pm.variables.set(\"sampleRequestedAt\", new Date().toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{crdUrl}}/cds-services/{{crdOrderSignServiceId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hook\": \"order-sign\",\n  \"hookInstance\": \"{{$guid}}\",\n  \"fhirServer\": \"https://ehr.example.invalid/fhir\",\n  \"context\": {\n    \"userId\": \"Practitioner/practitioner-1\",\n    \"patientId\": \"patient-1\",\n    \"draftOrders\": {\n      \"resourceType\": \"Bundle\",\n      \"type\": \"collection\",\n      \"entry\": [\n        {\n          \"resource\": {\n            \"resourceType\": \"ServiceRequest\",\n            \"id\": \"service-request-1\",\n            \"status\": \"draft\",\n            \"intent\": \"order\",\n            \"code\": {\n              \"coding\": [\n                {\n                  \"system\": \"http://www.ama-assn.org/go/cpt\",\n                  \"code\": \"95810\"\n                }\n              ]\n            },\n            \"subject\": {\n              \"reference\": \"Patient/patient-1\"\n            }\n          }\n        }\n      ]\n    }\n  },\n  \"prefetch\": {\n    \"patient\": {\n      \"resourceType\": \"Patient\",\n      \"id\": \"patient-1\",\n      \"identifier\": [\n        {\n          \"system\": \"https://member-id.example.invalid\",\n          \"value\": \"S123456789\"\n        }\n      ],\n      \"name\": [\n        {\n          \"family\": \"Placeholder-Surname\",\n          \"given\": [\n            \"Sample\"\n          ]\n        }\n      ],\n      \"birthDate\": \"1970-01-01\"\n    },\n    \"coverage\": {\n      \"resourceType\": \"Coverage\",\n      \"id\": \"coverage-1\",\n      \"status\": \"active\",\n      \"subscriberId\": \"S123456789\",\n      \"beneficiary\": {\n        \"reference\": \"Patient/patient-1\"\n      },\n      \"payor\": [\n        {\n          \"display\": \"Placeholder payer\"\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "Sample answer",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/fhir+json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"cards\": [\n    {\n      \"uuid\": \"sample-card-1\",\n      \"summary\": \"Sample card. Prior authorization required.\",\n      \"indicator\": \"info\",\n      \"source\": {\n        \"label\": \"Placeholder payer\"\n      },\n      \"extension\": [\n        {\n          \"url\": \"http://hl7.org/fhir/us/davinci-crd/StructureDefinition/ext-coverage-information\",\n          \"extension\": [\n            {\n              \"url\": \"covered\",\n              \"valueCode\": \"covered\"\n            },\n            {\n              \"url\": \"pa-needed\",\n              \"valueCode\": \"auth-needed\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"
            }
          ]
        },
