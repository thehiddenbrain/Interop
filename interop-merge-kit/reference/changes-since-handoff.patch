+<tr><td><code>D-SNP</code></td><td><code>sourceSystemId</code> 2064 and <code>productCode</code> DMA</td></tr>
+<tr><td><code>MA-TOGETHER</code></td><td><code>subsidiary</code> THPPMA, <code>sourceSystemId</code> 2026 and <code>productCode</code> PL or GT</td></tr>
