{
  "id": "dtr-02-adaptive-branching",
  "number": 2,
  "label": "Adaptive sequence, a later question depends on an earlier answer",
  "description": "The package holds one adaptive questionnaire with no questions of its own. Each next-question call returns the questions so far. Answering yes to the first question brings one follow-up, answering no brings a different one, and changing the first answer afterwards makes the earlier follow-up disappear.",
  "sentinelMemberId": "P32H-DTR-ADAPT",
  "behavior": "respond",
  "httpStatus": 200,
  "delayMillis": 150,
  "expect": {
    "outcome": "PACKAGE_LOADED",
    "errorType": "NONE",
    "httpStatus": 200,
    "codes": {
      "questionnaires": "1",
      "questionnaire-kind": "adaptive",
      "questionnaire-status": "active",
      "questions": "0"
    }
  },
  "basis": "Synthetic. Built from this tool's reading of Da Vinci DTR and SDC. It has not been observed from the live service.",
  "assumption": "How the live service marks an adaptive questionnaire, what next-question takes and returns, and what it names its completion status are not confirmed. This file models the questionnaireAdaptive extension, a QuestionnaireResponse returned with the questionnaire so far contained in it, the status in-progress while questions remain and completed at the end. It also models a service that returns the answers it was sent and drops the answer to a question it no longer asks.",
  "nextQuestion": {
    "rule": "The step is chosen from the answers in the QuestionnaireResponse that was sent. Each entry lists linkIds with the answer each must have: a code or a value, (any) for any answer at all, or (none) for no answer. The first entry that fits, in the order written, names the step. Answers that fit no entry are refused.",
    "select": [
      {
        "when": {
          "mri-1-therapy": "(none)"
        },
        "step": "first-question"
      },
      {
        "when": {
          "mri-1-therapy": "yes",
          "mri-2-weeks": "(none)"
        },
        "step": "therapy-weeks"
      },
      {
        "when": {
          "mri-1-therapy": "yes",
          "mri-2-weeks": "(any)"
        },
        "step": "complete-after-therapy"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "(none)"
        },
        "step": "red-flag"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "true",
          "mri-3-red-flag-detail": "(none)"
        },
        "step": "red-flag-detail"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "true",
          "mri-3-red-flag-detail": "(any)"
        },
        "step": "complete-with-red-flag"
      },
      {
        "when": {
          "mri-1-therapy": "no",
          "mri-2-red-flag": "false"
        },
        "step": "complete-without-red-flag"
      }
    ]
  },
