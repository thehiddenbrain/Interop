        <mxCell id="j1" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A6673;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2430;labelBackgroundColor=#FFFFFF;verticalAlign=middle;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="j_card" target="j_stored">
          <mxGeometry relative="1" as="geometry" />
